# ===== 服务 =====
# 监听地址与端口
BIND_HOST=0.0.0.0
PORT=3000
# 对外地址：用于分享链接、Origin 校验（生产必须与真实域名一致）
PUBLIC_URL=https://video.example.com

# ===== 存储 =====
DATA_DIR=./data
# 默认落在 $DATA_DIR/lightvideo.db，一般无需修改
# DATABASE_PATH=./data/lightvideo.db
WEB_DIR=../web

# ===== 会话与安全 =====
# 生产环境务必 true（仅 HTTPS 下发 Cookie）
SECURE_COOKIES=true
# 留空表示只允许同源；跨域部署时填写完整 Origin，逗号分隔
ALLOWED_ORIGINS=
# 部署在 Nginx / Caddy 之后设为 true，才能拿到真实客户端 IP
TRUST_PROXY=true
# 不设置则自动生成并持久化到 $DATA_DIR/jwt.key（至少 32 字节）
# JWT_SECRET=
SESSION_DAYS=14

# ===== 上传 =====
MAX_VIDEO_MB=4096
MAX_COVER_MB=12
CHUNK_SIZE_MB=4
MAX_UPLOAD_SESSIONS=6

# ===== 转码（可选，未安装 ffmpeg 会自动降级为原片直出） =====
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ===== 运行时 =====
# 0 / 不设置 = 使用全部 CPU 核心
WORKER_THREADS=0
RUST_LOG=lightvideo=info,tower_http=warn
